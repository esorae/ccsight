/target
.DS_Store

# Local denylist for `scripts/lint.sh` — contains domain-specific terms (real
# org/product/MCP/skill names) that must never appear in committed code.
# The file itself is the leak, so it is NEVER committed. See
# `.lint-forbidden-terms.example` for the format.
/.lint-forbidden-terms

# proptest writes a regression seed here on every failure. Seeds are RNG
# state, not input bytes — they stop reproducing once a generator changes —
# so committing them buys little and risks sweeping a stale seed in with
# `git add -A`.
/proptest-regressions
